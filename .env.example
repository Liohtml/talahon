# =============================================================================
# Talon — host configuration (.env in the project root)
# =============================================================================
#
# Copy to `.env` and fill in. Talon never loads this file into its own
# process environment, so secrets here are not inherited by containers,
# MCP servers or tools. Non-secret keys may also be set in the process
# environment (it wins); SECRET keys (marked [secret]) are read from this
# file only. `chmod 600 .env`.
#
# Check everything with:   talon doctor
# Restart after changes:   systemctl --user restart talon
#                          (macOS: launchctl kickstart -k gui/$(id -u)/com.talon)

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
ASSISTANT_NAME=Talon
# IANA timezone used for schedules and message timestamps.
TZ=UTC

# -----------------------------------------------------------------------------
# Model provider: vLLM (OpenAI-compatible API) — REQUIRED
# -----------------------------------------------------------------------------
# Without TALON_VLLM_BASE_URL + TALON_VLLM_MODEL the LLM gateway does not
# start and every agent run fails. Sampling / context knobs and per-group
# overrides are documented in .env.provider.example.
TALON_VLLM_BASE_URL=http://vllm.internal:8000
TALON_VLLM_MODEL=Qwen/Qwen3-32B
# Smaller model for compaction / extraction (optional, falls back to MODEL).
# TALON_VLLM_FAST_MODEL=Qwen/Qwen3-8B
# Context window of TALON_VLLM_MODEL in tokens (default 32768).
TALON_VLLM_MAX_CONTEXT=32768
# [secret] vLLM `--api-key`. Held only by the host LLM gateway; containers
# get a short-lived per-run gateway token instead. REQUIRED: without a key
# vLLM serves anyone who can reach it, so containers could bypass the
# gateway — Talon refuses to start the gateway (and every agent run fails)
# until it is set. `talon doctor` reports vllm_api_key_unset.
TALON_VLLM_API_KEY=
# Escape hatch: run the gateway without an upstream key. Only for a vLLM
# that agent containers provably cannot reach (e.g. bound to the host's
# loopback with the talon-agents network firewalled). Default false.
# TALON_VLLM_ALLOW_NO_API_KEY=false

# --- Anthropic instead of vLLM -------------------------------------------
# The agent still speaks the OpenAI-compatible API to the host gateway; the
# gateway translates to the Anthropic Messages API and keeps the key on the
# host. Set TALON_PROVIDER=anthropic and leave the TALON_VLLM_* keys alone.
# TALON_PROVIDER=anthropic
# TALON_ANTHROPIC_MODEL=claude-sonnet-5-5
# TALON_ANTHROPIC_FAST_MODEL=claude-haiku-5-5   # optional: compaction / extraction
# TALON_ANTHROPIC_MAX_CONTEXT=200000            # tokens (default 200000)
# TALON_ANTHROPIC_MAX_OUTPUT=16384
# TALON_ANTHROPIC_THINKING=false                # true = adaptive thinking
# TALON_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Secret, read by the host gateway only (never enters a container):
# TALON_ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Host LLM gateway (containers reach vLLM only through it)
# -----------------------------------------------------------------------------
# Listen port (default 3001).
# TALON_LLM_GATEWAY_PORT=3001
# Listen address. Unset: auto-detected — the container bridge address on
# Linux (e.g. 172.17.0.1), 127.0.0.1 on macOS. Never use 0.0.0.0.
# TALON_LLM_GATEWAY_BIND=172.17.0.1
# Host name containers use to reach the gateway (default host.docker.internal).
# TALON_LLM_GATEWAY_HOST=host.docker.internal
# Per-run-token request budget per minute (default 120, 0 disables).
# TALON_LLM_GATEWAY_RPM=120
# Also audit every successful model request (gateway.request), not only denials.
# TALON_LLM_GATEWAY_AUDIT_REQUESTS=false
# Simultaneous model requests across all runs (streams count until they end;
# bounds gateway memory). Excess requests get 503 + Retry-After. 0 disables.
# TALON_LLM_GATEWAY_MAX_CONCURRENT=32
# Per-lane vLLM `cache_salt`, so lanes never share prefix-cache blocks (no
# cross-lane timing side channel). Needs vLLM >= 0.9; set false for older
# vLLM or other OpenAI-compatible servers that reject the field.
# TALON_LLM_GATEWAY_CACHE_SALT=true

# -----------------------------------------------------------------------------
# CoPilot HTTP API (always on)
# -----------------------------------------------------------------------------
# [secret] Shared key CoPilot sends as `X-Api-Key` / `Authorization: Bearer`.
# Unset => every request except GET /health is rejected (fail closed).
# Generate: openssl rand -hex 32
HTTP_API_KEY=
COPILOT_HTTP_PORT=3100
# Listen address (default 127.0.0.1). Set it to the private interface
# CoPilot reaches; never 0.0.0.0 / :: on a host with a public interface
# (`talon doctor` reports http_api_public_bind).
COPILOT_HTTP_BIND=127.0.0.1
# Set to true only when a TLS-terminating reverse proxy fronts the API
# (silences the wildcard-bind warning at startup; the port itself must still
# be firewalled from everything but the proxy).
# COPILOT_HTTP_TLS_TERMINATED=false
# Connection limits (slow-client / FD exhaustion protection). Keep the per-IP
# limit above COPILOT_HTTP_MAX_STREAMS: CoPilot usually connects from one IP.
# COPILOT_HTTP_MAX_CONNECTIONS=512
# COPILOT_HTTP_MAX_CONNECTIONS_PER_IP=320
# Seconds a client has to send complete request headers.
# COPILOT_HTTP_HEADER_TIMEOUT_SECS=15
# Comma-separated browser origins allowed by CORS (empty = no CORS headers).
# COPILOT_HTTP_CORS_ORIGINS=https://copilot.example.internal
# Repeat /investigate calls for the same alert inside this window return the
# existing job (0 disables).
# COPILOT_INVESTIGATION_DEDUP_MINUTES=10
# Idle time before a per-user chat lane is dropped.
# SESSION_IDLE_HOURS=24
# COPILOT_HTTP_AUTH_MAX_FAILURES=10
# COPILOT_HTTP_AUTH_WINDOW_SECS=300
# COPILOT_HTTP_MAX_BODY_BYTES=262144
# COPILOT_HTTP_MAX_USER_LANES=256
# COPILOT_HTTP_MAX_STREAMS=256
# MemPalace (/palace/*): every call runs in a throw-away hardened container
# (agent image, mcp-palace user, no capabilities, read-only root, on the
# talon-agents network); disabled (503) when mempalace/ is not installed.
# Per-call timeout, container start included.
# COPILOT_PALACE_TIMEOUT_MS=30000
# DANGEROUS, do not set: `unsafe` would run mempalace/palace-call.sh directly
# ON THE HOST against agent-writable mempalace-data/ (host code execution,
# MYTH-01). `talon run` always uses the container runner and ignores it.
# TALON_PALACE_HOST_EXEC=
# COPILOT_JID=http:copilot
# COPILOT_GROUP_FOLDER=copilot

# -----------------------------------------------------------------------------
# Optional channels (each starts only when its credential is set)
# -----------------------------------------------------------------------------
# Telegram — [secret] bot token from @BotFather.
# TELEGRAM_BOT_TOKEN=

# Outbound webhook (scheduled digests -> CoPilot / SOAR).
# WEBHOOK_URL=https://soar.example.internal/hooks/talon
# [secret] HMAC key: requests carry X-Talon-Timestamp + X-Talon-Signature.
# WEBHOOK_SECRET=
# Hosts allowed without the egress check (exact or *.suffix), comma-separated.
# WEBHOOK_ALLOWED_HOSTS=soar.example.internal
# Send the secret as `Authorization: Bearer` too (old receivers only).
# WEBHOOK_LEGACY_BEARER=false

# Emacs bridge on 127.0.0.1 — [secret] bearer token the Emacs client sends.
# EMACS_AUTH_TOKEN=
# EMACS_CHANNEL_PORT=8766

# -----------------------------------------------------------------------------
# Egress policy (host-side fetches such as the webhook)
# -----------------------------------------------------------------------------
# Private/loopback/link-local destinations are refused unless allowed here.
# TALON_EGRESS_ALLOW=soar.example.internal,*.corp.example
# TALON_EGRESS_DENY=metadata.google.internal
# TALON_EGRESS_ALLOW_PRIVATE=false
# Hostnames resolved to 127.0.0.1 inside every agent container (fail closed).
# TALON_BLOCKED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------
# Deny every chat sender unless ~/.config/talon/sender-allowlist.json allows
# them (missing file => nobody may trigger the agent). An invalid file always
# denies everyone, required or not.
# TALON_SENDER_ALLOWLIST_REQUIRED=false

# -----------------------------------------------------------------------------
# Containers
# -----------------------------------------------------------------------------
# CONTAINER_RUNTIME=docker
# CONTAINER_IMAGE=talon-agent:latest
# Network agent (and palace) containers run on. Unset: the dedicated
# `talon-agents` bridge (inter-container traffic off), created at startup —
# `talon run` refuses to start if it cannot be created. Run
# `talon setup egress` once to add its egress firewall rules (metadata
# endpoints, internal services, direct vLLM access). `default` = the
# runtime's default bridge (NOT recommended: no isolation, no egress rules).
# TALON_CONTAINER_NETWORK=talon-agents
# Hard limit per run in ms (default 30 min; output frames extend it, up to
# 4x this value in total).
# CONTAINER_TIMEOUT=1800000
# Close an idle chat container after this many ms without output.
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5
# CONTAINER_MAX_OUTPUT_SIZE=10485760

# -----------------------------------------------------------------------------
# Loops
# -----------------------------------------------------------------------------
# Messages per prompt (most recent first are kept).
# MAX_MESSAGES_PER_PROMPT=10
# Fallback poll of the event-driven message loop (ms).
# POLL_INTERVAL=2000
# SCHEDULER_POLL_INTERVAL=60000
# IPC_POLL_INTERVAL=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# `json` for one JSON object per line (log shippers); default human-readable.
# TALON_LOG_FORMAT=json
# Filter, e.g. `info`, `talon=debug,talon_container=debug` (process env).
# RUST_LOG=info
