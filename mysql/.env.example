MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-username
MYSQL_PASS=your-password
MYSQL_DB=your-database

# Optional: use the native Rust MCP server (talon-mysql-mcp: same tools, arguments
# and result text, no Python cold start) instead of the Python mysql-mcp-server.
# Opt-in; the Python server stays the default. Notes for the Rust server:
#   - like the Python server it runs any single statement the account may run,
#     including INSERT/UPDATE/DELETE and DDL: restrict the account with GRANTs
#   - statements are bounded: TALON_MYSQL_QUERY_TIMEOUT=<seconds> (default 120),
#     TALON_MYSQL_MAX_ROWS (default 50000), TALON_MYSQL_MAX_RESULT_BYTES (default
#     1048576); a longer result is cut off with a "[RESULT TRUNCATED ...]" line
#   - MYSQL_SSL_MODE: unset / PREFERRED = TLS when the server offers it, certificate
#     not verified (as the Python server); DISABLED = never; REQUIRED, VERIFY_CA and
#     VERIFY_IDENTITY = TLS always, certificate chain and host name verified
#     against MYSQL_SSL_CA=/path/to/ca.pem (default: public web roots);
#     MYSQL_SSL_HOSTNAME=<name in the certificate> if it is not MYSQL_HOST
#   - MYSQL_CONNECT_TIMEOUT=<seconds> (default 10)
#   - not available: SSH tunnel (MYSQL_SSH_ENABLE), MCP resources and prompts
# TALON_MYSQL_MCP=rust
