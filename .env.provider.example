# =============================================================================
# Talon model provider — vLLM (instance-wide defaults)
# =============================================================================
#
# Talon speaks the OpenAI-compatible API served by vLLM
# (`/v1/chat/completions` with tool calling and guided decoding).
# TALON_PROVIDER is not configurable (anything but `vllm` is ignored with a
# warning).
#
# Put these keys in `.env` and restart Talon. Verify with:
#     talon doctor            (or: talon setup vllm)
#
# How the pieces fit:
#
#   agent container ──(per-run token)──▶ host LLM gateway ──(API key)──▶ vLLM
#
# The API key below never enters a container: each run gets a short-lived
# gateway token on stdin, revoked when the run ends. The gateway pins the
# model to the allowed list, clamps max_tokens, rate-limits per token and
# audits authentication failures.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# vLLM base URL, with or without the trailing /v1.
TALON_VLLM_BASE_URL=http://vllm.internal:8000
# The served model name (`vllm serve ... --served-model-name <name>`).
# Use a model with a working tool-call parser, e.g. Qwen3 (`--tool-call-parser
# hermes`), Llama 3.1+ (`llama3_json`), Mistral (`mistral`). Start vLLM with
# `--enable-auto-tool-choice`.
TALON_VLLM_MODEL=Qwen/Qwen3-32B

# -----------------------------------------------------------------------------
# Secret
# -----------------------------------------------------------------------------
# vLLM `--api-key`. Read from .env only (never from the process environment
# of child processes); redacted from every log line Talon writes.
# Required: without it the LLM gateway refuses to start, because a keyless
# vLLM lets agent containers bypass the gateway. Start vLLM with
# `--api-key <value>` and put the same value here.
TALON_VLLM_API_KEY=
# Only for a vLLM that agent containers provably cannot reach: run the
# gateway without an upstream key anyway (default false).
# TALON_VLLM_ALLOW_NO_API_KEY=false

# -----------------------------------------------------------------------------
# Optional tuning
# -----------------------------------------------------------------------------
# Smaller/faster model for context compaction and extraction work.
# TALON_VLLM_FAST_MODEL=Qwen/Qwen3-8B
# Context window of TALON_VLLM_MODEL in tokens (drives compaction; default 32768).
# TALON_VLLM_MAX_CONTEXT=32768
# Max output tokens per completion (also the gateway's clamp; default 16384).
# TALON_VLLM_MAX_OUTPUT=8192
# TALON_VLLM_TEMPERATURE=0.2
# TALON_VLLM_TOP_P=0.95
# Reasoning chat templates (Qwen3, DeepSeek-R1 distills): chat_template_kwargs.enable_thinking
# TALON_VLLM_ENABLE_THINKING=false
# Per-request timeout in seconds.
# TALON_VLLM_TIMEOUT_SECS=600

# -----------------------------------------------------------------------------
# Defense in depth: hosts routed to 127.0.0.1 inside every container
# -----------------------------------------------------------------------------
# Even if an agent finds a way around the gateway, third-party LLM APIs fail
# closed. Comma-separated; a group can add hosts, never remove them.
# TALON_BLOCKED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Per-group overrides (rare)
# -----------------------------------------------------------------------------
# A group can use a different model through its stored container config
# (`registered_groups.container_config` in store/messages.db), e.g.:
#
#   {"provider":"vllm","vllm":{"baseUrl":"http://vllm.internal:8000","model":"Qwen/Qwen3-8B"}}
#
# The group's `vllm` block replaces these defaults wholesale. The gateway only
# proxies to TALON_VLLM_BASE_URL, so an override must be served by the same
# vLLM endpoint; its model is added to the gateway's allow-list at startup.
# Sessions remember the model that produced them: switching models starts a
# fresh session instead of resuming an incompatible transcript.
