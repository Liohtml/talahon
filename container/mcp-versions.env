# Pinned versions of the third-party MCP servers Talahon runs.
#
# Single source of truth for the agent image (container/Dockerfile) and the
# host-side dev setup scripts (*/setup.sh). Plain KEY=value lines only: the
# file is sourced by POSIX sh and bash.
#
# These servers run inside the agent container next to SIEM, EDR and database
# credentials, so nothing here may float: git sources are pinned to a full
# commit SHA, PyPI packages to an exact version. To update one, review the
# upstream diff between the old and the new ref, change the line, rebuild the
# image (./container/build.sh) and run an investigation end to end.
#
# Transitive Python dependencies are not locked yet (no hash-checked lock
# files); the pins below cover the code that handles credentials directly.

# --- git sources (full commit SHAs) ---
COPILOT_MCP_REF=ab4ad56117984c05f4fcc54d0460c0bc8830d2fc
WAZUH_MCP_REF=06db9fbb952a195366fa747b9b4076c69ba369e3
VELOCIRAPTOR_MCP_REF=0c5547ebe1c1eb68e3c005fd3c6e397b00698292
SHUFFLE_MCP_REF=056fe99227004aecd342633aec6dc4123ff83945
CVE_MCP_REF=d666bac3743574cecc98bcbf524558c2bf0d8e61

# --- PyPI packages (exact versions) ---
OPENSEARCH_MCP_VERSION=2.1.9
MYSQL_MCP_VERSION=0.4.5
PYMYSQL_VERSION=1.2.4
# MemPalace 3.4+ needs chromadb 1.x, which changes the on-disk format of
# mempalace-data/. Moving past these two is a data migration, not a bump.
MEMPALACE_VERSION=3.3.1
CHROMADB_VERSION=0.6.3
PYYAML_VERSION=6.0.3
