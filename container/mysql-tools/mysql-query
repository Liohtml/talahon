#!/bin/bash
# mysql-query — credentialed MySQL helper for the agent.
#
# Reads SQL from stdin (or -e/-f), executes against the CoPilot MySQL
# database using credentials isolated to the mcp-mysql uid, returns
# results as JSON on stdout.
#
# Credential isolation (no sudo in the Talon image, docs/RUST_ARCHITECTURE.md
# §3.3): the MySQL credentials live in /etc/mcp-secrets/mysql.env, owned by
# the mcp-mysql user (mode 0600), and /opt/mysql-tools is only accessible to
# that user. This helper therefore works only when it runs as mcp-mysql (or
# on a dev host with MYSQL_* already exported). The agent itself cannot
# escalate to mcp-mysql — it uses the mcp__mysql__* MCP tools instead, which
# the supervisor runs as mcp-mysql.
#
# Usage:
#   mysql-query <<< "SELECT * FROM agents LIMIT 10"
#   echo "SELECT 1" | mysql-query
#   mysql-query -e "SHOW TABLES"
#   mysql-query -f script.sql
#   mysql-query -h
#
# Multi-statement scripts (separated by ';') return a JSON array, one
# entry per statement. Single-statement input returns a single JSON
# object: {"statement": "...", "rowcount": N, "rows": [...]}.

set -euo pipefail

case "${1:-}" in
    -h|--help)
        sed -n '2,/^# Multi-statement/p' "$0" | sed 's/^# //;s/^#$//;s/^#//'
        exit 0
        ;;
esac

ISOLATED_ENV="/etc/mcp-secrets/mysql.env"
if [ -r "$ISOLATED_ENV" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$ISOLATED_ENV"
    set +a
elif [ -e "$ISOLATED_ENV" ]; then
    echo "mysql-query: MySQL credentials are isolated to the mcp-mysql user and this" >&2
    echo "mysql-query: container has no sudo. Use the mcp__mysql__* tools instead." >&2
    exit 1
elif [ -z "${MYSQL_HOST:-}" ] || [ -z "${MYSQL_USER:-}" ]; then
    echo "mysql-query: no credentials ($ISOLATED_ENV absent and MYSQL_HOST/MYSQL_USER unset)" >&2
    exit 1
fi

PY=/opt/mysql-tools/bin/python
SCRIPT=/opt/mysql-tools/lib/mysql_query.py

if [ ! -x "$PY" ] || [ ! -f "$SCRIPT" ]; then
    echo "mysql-query: helper not installed at /opt/mysql-tools/" >&2
    exit 1
fi

case "${1:-}" in
    -h|--help)
        sed -n '2,/^# Multi-statement/p' "$0" | sed 's/^# //;s/^#$//;s/^#//'
        exit 0
        ;;
    -e)
        [ $# -ge 2 ] || { echo "mysql-query: -e requires SQL string" >&2; exit 1; }
        printf '%s' "$2" | exec "$PY" "$SCRIPT"
        ;;
    -f)
        [ $# -ge 2 ] || { echo "mysql-query: -f requires file path" >&2; exit 1; }
        [ -f "$2" ] || { echo "mysql-query: file not found: $2" >&2; exit 1; }
        exec "$PY" "$SCRIPT" < "$2"
        ;;
    "")
        # SQL on stdin
        exec "$PY" "$SCRIPT"
        ;;
    *)
        echo "mysql-query: unknown argument '$1'. Use -h for help." >&2
        exit 1
        ;;
esac
