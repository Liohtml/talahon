# OpenSearch connection details — copy this to .env and fill in your values
OPENSEARCH_HOSTS=https://your-opensearch-host:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password-here

# Set to "false" for self-signed / internal certs, "true" for valid CA-signed certs
VERIFY_CERTS=false

# Optional: use the native Rust MCP server (talahon-opensearch-mcp, read-only tools,
# no Python cold start) instead of the Python opensearch-mcp-server. Opt-in; the
# Python server stays the default. Notes for the Rust server:
#   - an unset VERIFY_CERTS means "verify" (the Python server defaults to not verifying)
#   - OPENSEARCH_CA_CERTS=/path/to/ca.pem trusts an internal CA with VERIFY_CERTS=true
#   - REQUEST_TIMEOUT=<seconds> (default 30)
# TALAHON_OPENSEARCH_MCP=rust
