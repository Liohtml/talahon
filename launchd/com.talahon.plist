<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Talahon launchd agent (macOS). Preferred: `talahon setup service`, which
  writes this file with escaped paths. Manual install:

    sed -e "s|{{TALAHON_BIN}}|$(pwd)/target/release/talahon|g" \
        -e "s|{{PROJECT_ROOT}}|$(pwd)|g" \
        -e "s|{{HOME}}|$HOME|g" \
        launchd/com.talahon.plist > ~/Library/LaunchAgents/com.talahon.plist
    mkdir -p logs
    launchctl load ~/Library/LaunchAgents/com.talahon.plist

  Secrets (TALAHON_VLLM_API_KEY, HTTP_API_KEY, bot tokens) belong in
  {{PROJECT_ROOT}}/.env, never in EnvironmentVariables below: the plist is
  world-readable and its environment is inherited by child processes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.talahon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{TALAHON_BIN}}</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>23</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:{{HOME}}/.local/bin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{{PROJECT_ROOT}}/logs/talahon.log</string>
    <key>StandardErrorPath</key>
    <string>{{PROJECT_ROOT}}/logs/talahon.error.log</string>
</dict>
</plist>
